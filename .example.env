# Google Cloud OAuth & Picker (required for Google Drive / Google Sheets mode;
# leave empty if you only want to use local .xlsx/.csv files).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# Numeric Google Cloud Project Number (recommended for Google Picker)
NEXT_PUBLIC_GOOGLE_APP_ID=

# Optional contact info sent in the User-Agent header to OpenStreetMap Nominatim
GEOCODER_CONTACT=
